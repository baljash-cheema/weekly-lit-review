# Copy this file to .env and fill it in. .env is never committed.
# In the cloud these same three values are stored as GitHub repository secrets.

# Claude API key (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=

# Gmail address that sends the review (and receives it, unless REVIEW_EMAIL_TO is set)
REVIEW_EMAIL=
# REVIEW_EMAIL_TO=

# Gmail app password for that account (16 characters; needs 2-Step Verification)
GMAIL_APP_PASSWORD=
